# Render service HTTPS origin, without a trailing route or query string:
VEEB_RESOLVER_URL=https://YOUR-EXISTING-RESOLVER.onrender.com
# A NEW random secret matching VEEB_SOURCE_AGENT_SECRET on Render.
# Do not use the Worker RESOLVER_SECRET here and do not commit this file with real values.
VEEB_SOURCE_AGENT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET
VEEB_AGENT_CACHE_MB=1024
